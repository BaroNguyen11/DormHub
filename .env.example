# Spring Boot API base URL. Do not put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set true only if you intentionally want demo data in a production build.
# Demo mode is already available when running Vite in development.
VITE_ENABLE_DEMO=false

# AI Chatbot Configuration (9Router OpenAI-compatible API)
# Development: Sử dụng Vite proxy để bypass CORS
# Production: Cần setup backend proxy hoặc dùng direct URL
VITE_AI_BASE_URL=/ai-proxy/v1
VITE_AI_API_KEY=your-9router-api-key-here
VITE_AI_MODEL=kr/claude-sonnet-4.5
