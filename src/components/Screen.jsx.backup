          [
            FileText,
            "Đăng ký minh bạch",
            "Theo dõi hồ sơ từ khi nộp đến khi được phân phòng.",
          ],
          [
            CreditCard,
            "Tài chính rõ ràng",
            "Xem hóa đơn và trạng thái thanh toán ở một nơi.",
          ],
          [
            Wrench,
            "Hỗ trợ kịp thời",
