        </div>
        <div className="hero-art">
          <div className="sun" />
          <div className="building-art">
            {Array.from({ length: 12 }, (_, i) => (
              <i key={i} />
            ))}
          </div>
          <div className="art-caption">A place to belong.</div>
        </div>
      </div>
      <div className="feature-grid">
        {[
          [
            Home,
            "Tìm phòng dễ dàng",
            "Xem sức chứa, vị trí và mức phí trước khi chọn.",
