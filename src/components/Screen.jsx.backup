import {
  ArrowRight,
  Search,
  Plus,
  RefreshCw,
  Send,
  Home,
  FileText,
  CreditCard,
  Wrench,
  ShieldCheck,
} from "lucide-react";
import { api, asList } from "../api/apiClient";
import { resources } from "../services/resource.service";
import { errorMessage } from "../utils/errorHandler";
import { date, money } from "../utils/format";
import GuestLayout from "../layouts/GuestLayout";
import StudentLayout from "../layouts/StudentLayout";
import ManagerLayout from "../layouts/ManagerLayout";
import { STATUS_LABELS, FILTERABLE_STATUSES } from "../constants/status";
import useDebounce from "../hooks/useDebounce";
import usePagination from "../hooks/usePagination";

const labels = {
  id: "Mã",
  name: "Tên",
  fullName: "Họ và tên",
  studentName: "Sinh viên",
  studentCode: "Mã sinh viên",
  email: "Email",
  phone: "Số điện thoại",
  roomNumber: "Phòng",
  buildingName: "Tòa nhà",
  buildingId: "Mã tòa nhà",
  roomId: "Mã phòng",
  roomType: "Loại phòng",
  capacity: "Sức chứa",
  availableSlots: "Chỗ trống",
  monthlyPrice: "Giá hàng tháng",
  price: "Giá",
  floor: "Tầng",
  gender: "Giới tính",
  status: "Trạng thái",
  createdAt: "Ngày tạo",
  startDate: "Ngày bắt đầu",
  endDate: "Ngày kết thúc",
  dueDate: "Hạn thanh toán",
  period: "Kỳ",
  totalAmount: "Tổng tiền",
  amount: "Số tiền",
  type: "Loại",
  title: "Tiêu đề",
  body: "Nội dung",
  description: "Mô tả",
  priority: "Mức ưu tiên",
  month: "Tháng",
  year: "Năm",
  electricityAmount: "Tiền điện",
  waterAmount: "Tiền nước",
  serviceAmount: "Phí dịch vụ",
  termName: "Đợt đăng ký",
  contractId: "Mã hợp đồng",
  invoiceId: "Mã hóa đơn",
  method: "Phương thức",
  role: "Vai trò",
  read: "Đã đọc",
  action: "Hành động",
  resource: "Đối tượng",
  address: "Địa chỉ",
};
const fields = {
  email: { type: "email" },
  phone: { type: "tel" },
  description: { tag: "textarea" },
  body: { tag: "textarea" },
  note: { tag: "textarea" },
  expectedCheckInDate: { type: "date" },
  dueDate: { type: "date" },
  startDate: { type: "date" },
  endDate: { type: "date" },
  month: { type: "number", min: 1, max: 12 },
  year: { type: "number", min: 2020 },
  capacity: { type: "number", min: 1 },
  floor: { type: "number", min: 0 },
  monthlyPrice: { type: "number", min: 0 },
  electricityAmount: { type: "number", min: 0 },
  waterAmount: { type: "number", min: 0 },
  serviceAmount: { type: "number", min: 0 },
  gender: { options: ["Nam", "Nữ"] },
  role: { options: ["STUDENT", "MANAGER"] },
  status: { options: ["ACTIVE", "OPEN", "CLOSED", "MAINTENANCE", "LOCKED"] },
  priority: { options: ["LOW", "MEDIUM", "HIGH", "URGENT"] },
};
const statusLabels = STATUS_LABELS;
const statusClass = (value) =>
  /^(APPROVED|ACTIVE|PAID|RESOLVED|OPEN|SUCCESS|CHECKED_IN)$/i.test(value)
    ? "green"
    : /^(REJECTED|FAILED|OVERDUE|CLOSED)$/i.test(value)
      ? "red"
      : "amber";
const isDate = (key) => /(At|Date)$/.test(key);
const isMoney = (key) => /(Amount|Price|Fee)$/.test(key);
const pretty = (key, value) => {
  if (value == null || value === "") return "—";
  if (key === "status")
    return (
      <span className={`status ${statusClass(value)}`}>
        {statusLabels[value] || value}
      </span>
    );
  if (typeof value === "boolean") return value ? "Có" : "Chưa";
  if (isMoney(key)) return money(value);
  if (isDate(key)) return date(value);
  if (Array.isArray(value))
    return value
      .map((v) => (typeof v === "object" ? v.name || v.id : v))
      .join(", ");
  if (typeof value === "object")
    return value.name || value.fullName || value.id || JSON.stringify(value);
  return String(value);
};
const getValue = (row, key) =>
  row?.[key] ?? row?.room?.[key] ?? row?.student?.[key] ?? row?.building?.[key];

function Notice({ error, success }) {
  return (
    <>
      {error && (
        <div role="alert" className="notice error">
          {error}
        </div>
      )}
      {success && (
        <div role="status" className="notice success">
          {success}
        </div>
      )}
    </>
  );
}
function Loading() {
  return (
    <div className="empty-state">
      <RefreshCw className="spin" size={21} />
      <strong>Đang tải dữ liệu…</strong>
    </div>
  );
}
function Empty({ text = "Chưa có dữ liệu phù hợp." }) {
  return (
    <div className="empty-state">
      <Search size={22} />
      <strong>{text}</strong>
      <p>Dữ liệu sẽ xuất hiện khi máy chủ có thông tin tương ứng.</p>
    </div>
  );
}
function Heading({ config, children }) {
  return (
    <div className="page-heading">
      <div>
        <p className="eyebrow">DORMHUB / {config.group.toUpperCase()}</p>
        <h1>{config.title}</h1>
        <p className="subheading">
          Quản lý thông tin và theo dõi tiến trình trên cùng một không gian.
        </p>
      </div>
      <div className="heading-actions">{children}</div>
    </div>
  );
}

function useLoad(path, params) {
  const [data, setData] = useState(null),
    [error, setError] = useState(""),
    [loading, setLoading] = useState(true),
    [version, setVersion] = useState(0);
  const reload = () => setVersion((v) => v + 1);
  const paramsKey = JSON.stringify(params);
  useEffect(() => {
    let live = true;
    Promise.resolve()
      .then(() => {
        if (!live) return null;
        setLoading(true);
        setError("");
        return resources.list(path, JSON.parse(paramsKey));
      })
      .then((result) => {
        if (live) setData(result);
      })
      .catch((e) => {
        if (live) setError(errorMessage(e));
      })
      .finally(() => {
        if (live) setLoading(false);
      });
    return () => {
      live = false;
    };
  }, [path, paramsKey, version]);
  return { data, error, loading, reload };
}

